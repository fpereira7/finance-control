{
  "info": {
    "name": "Finance Control - Monthly Expenses",
    "description": "CRUD de despesas mensais com filtros.\n\n1. Execute Login (ou Login as migration user) para preencher accessToken.\n2. As demais requests usam Authorization: Bearer {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": "user@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    },
    {
      "key": "expenseId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Obtém JWT e salva em accessToken."
          },
          "response": []
        },
        {
          "name": "Login as migration user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"migration@local\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Login do usuário da migration V6 (dados pré-existentes)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create monthly expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.id) {",
              "    pm.collectionVariables.set('expenseId', json.id);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"RENT\",\n  \"amount\": 1500.00,\n  \"dueDate\": \"2026-08-10\",\n  \"paymentStatus\": \"PENDING\"\n}"
        },
        "url": "{{baseUrl}}/api/monthly-expenses",
        "description": "Cria uma despesa mensal.\n\nCategorias: RENT, ENERGY, GAS, WATER, INTERNET, PHONE, INSURANCE, EDUCATION, HEALTH, TRANSPORT, OTHER\n\nStatus: PAID, PENDING"
      },
      "response": []
    },
    {
      "name": "List monthly expenses",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/monthly-expenses",
        "description": "Lista todas as despesas mensais do usuário autenticado."
      },
      "response": []
    },
    {
      "name": "List monthly expenses with filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/monthly-expenses?year=2026&month=8&status=PENDING&category=ENERGY",
          "host": ["{{baseUrl}}"],
          "path": ["api", "monthly-expenses"],
          "query": [
            {
              "key": "year",
              "value": "2026",
              "description": "Ano (obrigatório se month for informado)"
            },
            {
              "key": "month",
              "value": "8",
              "description": "Mês (1-12). Exige year."
            },
            {
              "key": "status",
              "value": "PENDING",
              "description": "PAID ou PENDING"
            },
            {
              "key": "category",
              "value": "ENERGY",
              "description": "Categoria da despesa"
            }
          ]
        },
        "description": "Lista despesas com filtros opcionais: year, month, status, category."
      },
      "response": []
    },
    {
      "name": "Get monthly expense by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/monthly-expenses/{{expenseId}}",
        "description": "Busca uma despesa pelo id (somente do usuário autenticado)."
      },
      "response": []
    },
    {
      "name": "Update monthly expense",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"RENT\",\n  \"amount\": 1600.00,\n  \"dueDate\": \"2026-08-10\",\n  \"paymentStatus\": \"PAID\"\n}"
        },
        "url": "{{baseUrl}}/api/monthly-expenses/{{expenseId}}",
        "description": "Atualiza uma despesa existente."
      },
      "response": []
    },
    {
      "name": "Delete monthly expense",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/monthly-expenses/{{expenseId}}",
        "description": "Remove uma despesa pelo id."
      },
      "response": []
    }
  ]
}

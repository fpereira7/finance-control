{
  "info": {
    "name": "Finance Control - Auth",
    "description": "Registro e login JWT. O token é salvo na variável accessToken após login/register e pode ser reutilizado nas demais collections com o header Authorization: Bearer {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": "user@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    }
  ],
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"Usuario Exemplo\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Cria um usuário e retorna JWT.\n\n- email: obrigatório, único\n- password: mínimo 8 caracteres\n- name: opcional\n\nResposta: accessToken, tokenType (Bearer), expiresIn (segundos), user."
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Autentica e retorna JWT.\n\nUsuário de migration (dados antigos):\n- email: migration@local\n- password: ChangeMe123!"
      },
      "response": []
    },
    {
      "name": "Login as migration user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"migration@local\",\n  \"password\": \"ChangeMe123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Login do usuário criado na migration V6 (dona dos dados pré-existentes)."
      },
      "response": []
    },
    {
      "name": "Example authenticated request - Monthly summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/monthly-summary?year=2026&month=8",
          "host": ["{{baseUrl}}"],
          "path": ["api", "monthly-summary"],
          "query": [
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "month",
              "value": "8"
            }
          ]
        },
        "description": "Exemplo de chamada autenticada. Execute Register ou Login antes para preencher accessToken."
      },
      "response": []
    }
  ]
}
